# Add only this entry to an existing mcpServers mapping. Do not replace the file.
# Co-location prerequisite: this process can reach the ONE loopback backend.
# Installed on retained EC2 through install-reader.cjs; placeholders below are portable.
# Also allow only the six exact *_mcp_aws_secops_reader tool names in native
# toolApproval.allow. install-reader.cjs preserves historical ASK/DENY entries.
mcpServers:
  aws_secops_reader:
    type: stdio
    command: /absolute/path/aws-secops/.venv-mcp/bin/python
    args: ["-m", "pilot_v1.mcp_bridge"]
    env:
      PYTHONPATH: /absolute/path/aws-secops
      SECOPS_BACKEND_URL: http://localhost:3340
    timeout: 105000
    initTimeout: 15000
    chatMenu: false
    serverInstructions: true
