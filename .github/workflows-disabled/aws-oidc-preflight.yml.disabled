# Disabled by runner-economy rollout; preserved for reversible reuse.
name: AWS OIDC preflight

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: aws-secops-oidc-preflight
  cancel-in-progress: false

jobs:
  preflight:
    if: github.ref == 'refs/heads/main' && github.repository == 'amitkarpe/aws-secops'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      id-token: write
    env:
      AWS_REGION: ap-southeast-1
      AWS_ROLE_ARN: ${{ vars.AWS_SECOPS_PREFLIGHT_ROLE_ARN }}
      AWS_ALLOWED_ACCOUNT_ID: ${{ vars.AWS_ALLOWED_ACCOUNT_ID }}
    steps:
      - name: Checkout
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false

      - name: Require configured deployment identity
        shell: bash
        run: |
          set -euo pipefail
          test -n "${AWS_ROLE_ARN:-}"
          test -n "${AWS_ALLOWED_ACCOUNT_ID:-}"

      - name: Configure AWS credentials with GitHub OIDC
        uses: aws-actions/configure-aws-credentials@61815dcd50bd041e203e49132bacad1fd04d2708 # v5
        with:
          role-to-assume: ${{ env.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}
          allowed-account-ids: ${{ env.AWS_ALLOWED_ACCOUNT_ID }}

      - name: Verify caller and Region
        shell: bash
        run: |
          set -euo pipefail
          ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
          test "$ACCOUNT_ID" = "$AWS_ALLOWED_ACCOUNT_ID"
          test "$AWS_REGION" = "ap-southeast-1"
          echo "AWS identity and Region: PASS" >> "$GITHUB_STEP_SUMMARY"

      - name: Read-only retained aws-secops state
        shell: bash
        run: |
          set -euo pipefail
          aws configservice describe-configuration-recorders >/dev/null
          aws lambda list-functions --query "Functions[?starts_with(FunctionName, 'aws-secops-')].FunctionName" >/tmp/aws-secops-functions.json
          aws bedrock-agentcore-control list-gateways --query "items[?starts_with(name, 'aws-secops-')].[name,status]" >/tmp/aws-secops-gateways.json
          echo "Read-only retained state checks: PASS" >> "$GITHUB_STEP_SUMMARY"

      - name: Explicit non-mutation statement
        run: echo "This workflow performs authentication and read-only AWS checks only; it does not deploy or mutate Demo v1." >> "$GITHUB_STEP_SUMMARY"
